rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // Your own Firebase uid: Firebase console -> Authentication -> Users -> "User UID".
    function isAdmin() {
      return request.auth != null && request.auth.uid == 'PUT_YOUR_UID_HERE';
    }

    function chapterPublished(chapterId) {
      return get(/databases/$(database)/documents/chapters/$(chapterId)).data.published == true;
    }

    // espace prof (même comportement qu'avant)
    match /users/{uid}/students/{id} {
      allow read, write: if isOwner(uid);
    }
    match /users/{uid}/meta/groups {
      allow read, write: if isOwner(uid);
    }
    match /users/{uid}/meta/profile {
      allow read, write: if isOwner(uid);
    }

    // rôle: création une seule fois, pas de modification
    match /users/{uid}/meta/account {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['role', 'createdAt'])
        && request.resource.data.role in ['teacher', 'student'];
      allow update: if false;
      allow delete: if isOwner(uid);
    }

    // espace élève: progression personnelle (placement + chapitres)
    match /users/{uid}/progress/{doc} {
      allow read, write: if isOwner(uid);
    }

    // notes personnelles de l'élève (une note = un feuillet dans le dossier du chapitre)
    match /users/{uid}/notes/{noteId} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['chapterId', 'title', 'body', 'updatedAt'])
        && request.resource.data.chapterId is string
        && request.resource.data.chapterId.size() <= 100
        && request.resource.data.title is string
        && request.resource.data.title.size() <= 100
        && request.resource.data.body is string
        && request.resource.data.body.size() <= 4000
        && request.resource.data.updatedAt is number;
    }

    // appareils connectés de l'élève (un document par navigateur; jamais l'adresse IP)
    match /users/{uid}/sessions/{sid} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['type', 'os', 'browser', 'city', 'country', 'code', 'createdAt', 'lastActive', 'revoked', 'revokedAt'])
        && request.resource.data.type in ['phone', 'tablet', 'computer']
        && request.resource.data.get('os', '') is string
        && request.resource.data.get('os', '').size() <= 30
        && request.resource.data.get('browser', '') is string
        && request.resource.data.get('browser', '').size() <= 30
        && request.resource.data.get('city', '') is string
        && request.resource.data.get('city', '').size() <= 60
        && request.resource.data.get('country', '') is string
        && request.resource.data.get('country', '').size() <= 60
        && request.resource.data.get('code', '') is string
        && request.resource.data.get('code', '').size() <= 2
        && request.resource.data.get('revoked', false) is bool;
    }

    // Test de niveau: un seul document (tests/placement) envoyé depuis la page admin.
    // Lecture pour les comptes connectés, écriture admin seulement.
    match /tests/{testId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // Contenu du livre: lecture pour les comptes connectés (chapitres publiés), écriture admin seulement.
    // Les requêtes de liste doivent filtrer sur published == true (le code le fait).
    match /chapters/{chapterId} {
      allow read: if request.auth != null && (resource.data.published == true || isAdmin());
      allow write: if isAdmin();

      match /exercises/{exId} {
        allow read: if request.auth != null && (chapterPublished(chapterId) || isAdmin());
        allow write: if isAdmin();

        match /private/{docId} {
          allow read: if request.auth != null && (chapterPublished(chapterId) || isAdmin());
          allow write: if isAdmin();
        }
      }
    }
  }
}
