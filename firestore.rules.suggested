rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // Role: written once at account creation, never changed afterwards.
    match /users/{uid}/meta/account {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['role', 'createdAt'])
        && request.resource.data.role in ['teacher', 'student'];
      allow update: if false;
      allow delete: if isOwner(uid);   // needed by "Delete account"
    }

    // Other meta documents (groups, profile)
    match /users/{uid}/meta/{docId} {
      allow read, write: if isOwner(uid) && docId in ['groups', 'profile'];
    }

    // Teacher side
    match /users/{uid}/students/{studentId} {
      allow read, write: if isOwner(uid);
    }

    // Student side
    match /users/{uid}/progress/{docId} {
      allow read, write: if isOwner(uid);
    }

    // Everything else is denied by default.
  }
}
